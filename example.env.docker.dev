# PostgreSQL configuration used by docker-compose.yml.
# Copy this file to `.env` in the repository root and fill in your own values.
#
# Do not commit the result: `.env` is gitignored and excluded from every Docker
# build context. Choose your own password rather than reusing a shared one.

DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME_use_a_generated_password
DB_NAME=learning_app
DB_PORT=5433
