// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                Int                 @id @default(autoincrement())
  email             String              @unique
  name              String?
  role              String?             @default("user")
  subscribed        Boolean             @default(false)
  /// When they last signed in through Keycloak.
  ///
  /// The only reliable mark of a real account. A User row is also created the
  /// moment someone is assigned work, so its mere existence proves nothing, and
  /// `name` cannot stand in for it — not every realm sends a name claim, which
  /// left genuine accounts looking like bare email addresses.
  lastSignInAt      DateTime?
  sectionViews      SectionProgress[]
  elementViews      ElementProgress[]
  quizAttempts      QuizAttempt[]
  quizSessions      QuizSession[]
  notes             Note[]
  completions       CourseCompletion[]
  /// Courses this person created. They own them: nobody else reaches them
  /// unless they are named on `editableCourses` below.
  authoredCourses   Course[]            @relation("CourseAuthor")
  /// Courses this person may edit. Empty means no Course Editor access.
  editableCourses   Course[]            @relation("CourseContributors")
  /// Assignments this person handed out. Their address is the one the learner
  /// hears from, so a reply lands with whoever set the work.
  assignmentsMade   Assignment[]        @relation("AssignmentAssigner")
  /// Course versions this person put live, for the archive list.
  publishedVersions CoursePublication[] @relation("PublishedVersions")
  /// Versions this person marked to be kept for good.
  archivedVersions  CoursePublication[] @relation("ArchivedVersions")
  /// What this person currently has open for editing, so two authors in one
  /// course do not overwrite each other. At most a handful of rows at a time.
  editLeases        EditLease[]
  /// Draft edits credited to this person. Cleared when the course is published,
  /// because at that point there is no unpublished change left to attribute.
  editedModules     Module[]            @relation("ModuleEditor")
  editedSections    Section[]           @relation("SectionEditor")
  editedElements    Element[]           @relation("ElementEditor")
  editedQuizzes     Quiz[]              @relation("QuizEditor")
  editedQuestions   Question[]          @relation("QuestionEditor")
}

/// What kind of thing a Course is.
///
/// Both are the same shape — modules holding sections holding content — and
/// share publishing, versioning, access and the whole learner path. They differ
/// only in what an author is offered while editing one, and in which tab it
/// appears under.
enum CourseKind {
  /// A lesson: sections of elements, with quizzes dropped in among them.
  LESSON
  /// A quiz set: one module, and a section per quiz. No elements.
  QUIZ_SET
}

/// The top-level container an admin creates by name, then fills with content.
model Course {
  id               String     @id @default(uuid())
  title            String
  /// Lesson or quiz set. Decides which tab lists it and what the editor offers.
  kind             CourseKind @default(LESSON)
  /// One-line pitch shown under the title on the course page.
  shortDescription String?
  /// The long description shown further down the course page.
  description      String?
  tags             String[]   @default([])
  languages        String[]   @default([])
  /// Bullet points for the "What you'll learn" box.
  whatYouWillLearn String[]   @default([])
  prerequisites    String[]   @default([])
  required         Boolean    @default(false) // required learning
  dueDate          DateTime? // when required learning must be finished
  /// How long someone gets once this is handed to them, in days.
  ///
  /// The deadline an author sets is a length rather than a date: a course
  /// assigned today and the same course assigned next month should each give
  /// the learner the same run at it, which one fixed `dueDate` cannot do. The
  /// assignment's own `dueDate` is stamped from this at the moment it is made —
  /// see AssignmentService.assign — and `dueDate` above stays as the single
  /// course-wide deadline for anything that never went through an assignment.
  daysRemaining    Int?
  published        Boolean    @default(false) // hidden from learners until published
  /// When on, a section stays locked until every earlier section is finished.
  sequential       Boolean    @default(false)
  /// Whether the deadline shuts the course, or only reports that it passed.
  ///
  /// On, and once the due date has gone the learner cannot open anything: the
  /// way in is closed and the quizzes inside refuse to start. That is right for
  /// a compliance course, where sitting it late is the same as not sitting it.
  ///
  /// Off, and the deadline is a date rather than a gate — the course still says
  /// it is overdue, everywhere it said so before, but the learner may carry on
  /// and finish. That is right for most learning, where a week late is worth far
  /// more than never.
  ///
  /// On by default, because that is what a deadline meant here before this was
  /// a choice, and quietly opening every existing course would be a change
  /// nobody asked for.
  lockAfterDue     Boolean    @default(true)
  publishedAt      DateTime? // stamped the first time it is published
  /// Which CoursePublication learners are currently served. 0 means the course
  /// has never been published, so there is nothing for a learner to read.
  ///
  /// Authors edit the live rows below freely; none of it reaches a learner until
  /// a publish snapshots it. That is what lets an edit to existing content be
  /// held back as surely as a brand new section.
  publishedVersion Int        @default(0)
  /// Touched by every content edit. Compared against the current publication's
  /// date to answer "are there unpublished changes?" without diffing the tree.
  draftUpdatedAt   DateTime   @default(now())
  imageData        String?    @db.Text // base64 cover photo shown on the Learning page
  imageType        String? // MIME type of the cover photo
  deletedAt        DateTime? // soft delete: recoverable from the admin dashboard
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @default(now()) @updatedAt
  /// Bumped only when a section or quiz is added. Compared against a learner's
  /// completion date to tell them there is something new.
  contentUpdatedAt DateTime   @default(now())
  /// Who made this, and so who owns it.
  ///
  /// Authoring rights used to follow from the Keycloak role alone, which made
  /// every admin an author of everything: one person's draft sat on every other
  /// admin's Create a Lesson page, ready to be edited or deleted. Ownership is
  /// recorded here instead, and `contributors` below is how it is shared — so a
  /// course is reachable by the person who made it and by whoever they named,
  /// and by nobody else whatever role they hold.
  ///
  /// Null on courses that predate this column and could not be attributed to
  /// anyone (see the backfill in the migration). Those stay visible to global
  /// authors, because otherwise they would belong to nobody and be unreachable.
  createdById      Int?
  createdBy        User?      @relation("CourseAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  modules      Module[]
  sections     Section[]
  completions  CourseCompletion[]
  /// People allowed to edit this one course without being global authors.
  contributors User[]              @relation("CourseContributors")
  instructors  Instructor[]
  notes        Note[]
  assignments  Assignment[]
  publications CoursePublication[]
  /// Who currently has a module or a question in this course open.
  editLeases   EditLease[]

  @@index([kind])
  @@index([createdById])
}

/// One published version of a course, frozen at the moment it went live.
///
/// The whole course tree is stored as JSON rather than as a second set of rows.
/// Two reasons. Progress is keyed on element, section and quiz ids, and those
/// have to stay stable across a publish or every learner's history would break —
/// copying rows would mint new ids. And authors get to keep editing the live
/// tables exactly as before, with no draft/live pair on every column: the
/// snapshot is what a learner reads, so an unpublished edit is invisible for
/// free.
///
/// The cost is that snapshots carry their elements' base64 media, so they are
/// large. That is bounded by the retention sweep, which keeps only the live
/// version and whatever was superseded inside the archive window.
model CoursePublication {
  id            String    @id @default(uuid())
  courseId      String
  course        Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// 1-based, and the number Course.publishedVersion points at.
  version       Int
  /// The course tree as learners see it at this version.
  snapshot      Json
  publishedAt   DateTime  @default(now())
  publishedById Int?
  publishedBy   User?     @relation("PublishedVersions", fields: [publishedById], references: [id], onDelete: SetNull)
  /// Set when a newer version replaced this one. Null on the live version, which
  /// is never purged however old it gets.
  supersededAt  DateTime?
  /// Set when someone deliberately kept this version for good.
  ///
  /// The ordinary archive is a grace period: a replaced version is readable for
  /// fourteen days and then cleared, which is right for the dozens of versions
  /// nobody will ever look at again. This is the escape hatch for the few that
  /// matter — the one that was audited, the one signed off — and a row with this
  /// set is never touched by the purge however long ago it was replaced.
  ///
  /// Clearing it does not delete the version: it drops back into the ordinary
  /// history, and the fourteen days start from that moment rather than from the
  /// publish it was replaced by, so keeping something and then changing your
  /// mind never destroys it on the spot.
  archivedAt    DateTime?
  archivedById  Int?
  archivedBy    User?     @relation("ArchivedVersions", fields: [archivedById], references: [id], onDelete: SetNull)

  /// What this version added compared with the one before it, so a learner who
  /// had already finished can be shown exactly what is new. Worked out once at
  /// publish time rather than by diffing two snapshots on every page load.
  newModuleIds  String[] @default([])
  newSectionIds String[] @default([])
  newElementIds String[] @default([])
  newQuizIds    String[] @default([])

  @@unique([courseId, version])
  @@index([courseId, publishedAt])
  @@index([supersededAt])
  @@index([archivedById])
}

/// Someone credited on a course. Courses can list more than one.
model Instructor {
  id        String   @id @default(uuid())
  name      String
  /// Job title or role, shown under the name.
  title     String?
  bio       String?  @db.Text
  photoData String?  @db.Text
  photoType String?
  createdAt DateTime @default(now())
  courses   Course[]
}

/// Which of the two ways a piece of content was handed to someone.
enum AssignmentType {
  /// Enrolled on the platform. They sign in with this email and find the course
  /// in their Learning tab; the token is never published to them.
  PLATFORM
  /// Sent as a direct link. The token in the URL is the credential and no login
  /// is involved. Deliberately invisible to the same person when signed in, so a
  /// one-off link never turns into a permanent enrolment.
  LINK
}

/// A course or quiz handed to someone by email.
///
/// One assignment is one course or one quiz, and a LINK assignment's URL opens
/// exactly that — someone given three courses gets three separate links. For a
/// LINK the token IS the credential: anyone holding it acts as `email`. Progress
/// is recorded against the User row for that address either way, so a guest who
/// later signs in through Keycloak with the same email keeps their history.
model Assignment {
  id                String         @id @default(uuid())
  type              AssignmentType @default(LINK)
  /// High-entropy random string. Appears in the public URL for a LINK assignment;
  /// held but never published for a PLATFORM one.
  token             String         @unique
  email             String
  courseId          String?
  course            Course?        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quizId            String?
  quiz              Quiz?          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  /// Who handed this over. Their address is used as the From and Reply-To on
  /// every mail about it, so the learner answers a person rather than a system
  /// mailbox. Null on rows created before assignments recorded this.
  assignedById      Int?
  assignedBy        User?          @relation("AssignmentAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedAt        DateTime       @default(now())
  dueDate           DateTime?
  /// Optional cut-off; the link stops working after this.
  expiresAt         DateTime?
  /// Set to kill a link early without deleting the record.
  revokedAt         DateTime?
  /// Stamped when a ONE_TIME quiz behind this link has been handed in. The quiz
  /// is closed from that moment; the link stays open for exactly one more visit,
  /// so the holder can come back to their result rather than to a bare error.
  completedAt       DateTime?
  /// Stamped the first time the link is opened *after* it was completed — the one
  /// visit that shows the result. Opening it again after this closes the link for
  /// good, which is what `revokedAt` then records. Kept apart from
  /// `lastAccessedAt` because that moves on every request, and a single page load
  /// makes several.
  resultsSeenAt     DateTime?
  lastAccessedAt    DateTime?
  /// When the notification email actually went out. Null means it was never sent
  /// — no mail credentials configured, or the send failed.
  notifiedAt        DateTime?
  /// Mails sent about this assignment inside the current window. Together with
  /// `notifyWindowStart` this is the whole rate limit: flipping the link off and
  /// on again re-sends, but only so many times before it refuses.
  notifyCount       Int            @default(0)
  notifyWindowStart DateTime?

  @@index([email])
  @@index([courseId])
  @@index([quizId])
  @@index([assignedById])
}

/// Stamped the first time a learner reaches 100% of a course.
///
/// Kept separate from progress because progress answers "how far are they", while
/// this answers "had they finished before this content appeared" — which is what
/// makes a new-content notice meaningful rather than noise.
model CourseCompletion {
  id           String    @id @default(uuid())
  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId     String
  course       Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  completedAt  DateTime  @default(now())
  /// What they finished, so the notice can say how much is new.
  sectionCount Int       @default(0)
  /// When they were last emailed that this course had gained content. Stops a
  /// burst of edits turning into a burst of mail.
  notifiedAt   DateTime?

  @@unique([userId, courseId])
}

/// A learner's own notes, kept per course and optionally pinned to a section.
model Note {
  id        String   @id @default(uuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sectionId String?
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId, courseId])
  @@index([sectionId])
}

/// A named group of sections, and the first digit of every section number inside it.
///
/// Course structure is a two-dimensional grid: the module is the outer index and
/// the section its inner one, so module 2's third section is "2.3". `number` is the
/// module's 1-based place in the course, which the author sets directly.
model Module {
  id             String    @id @default(uuid())
  courseId       String
  course         Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  number         Int
  title          String
  /// Hex tint the author picked, e.g. "#c7d9f0". Used at low opacity behind the
  /// module's sections so a long course reads as groups at a glance. Null means
  /// no tint, which is the default.
  color          String?
  deletedAt      DateTime? // soft delete: recoverable from the admin dashboard
  /// Who last changed this while it was still a draft, and when.
  ///
  /// Cleared for the whole course at publish time, because the question these
  /// answer is "what has changed that learners cannot see yet, and who did it" —
  /// once it is published there is no such change left to attribute, and leaving
  /// the marks up would tag every course forever.
  lastEditedById Int?
  lastEditedAt   DateTime?
  lastEditedBy   User?     @relation("ModuleEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)
  sections       Section[]

  @@unique([courseId, number])
  @@index([courseId, number])
  @@index([lastEditedById])
}

/// A part of a course, living inside a module.
///
/// `position` is the section's 1-based place within its module — the digit after
/// the dot. `number` ("2.3") and `sortKey` (zero-padded, so "1.10" sorts after
/// "1.2") are derived from module.number and position and stored so ordering and
/// display cost nothing to read. Never set them by hand: they are rewritten
/// wholesale by the renumbering pass in CurriculumService.
model Section {
  id               String            @id @default(uuid())
  courseId         String
  course           Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleId         String?
  module           Module?           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  position         Int               @default(1)
  number           String
  sortKey          String
  title            String
  estimatedMinutes Int               @default(0) // admin's estimate; summed for the course total
  /// Hex tint the author picked, from the same closed palette a module uses.
  ///
  /// Modules already carried one, which was enough while a section was only ever
  /// read inside its module's group. A quiz set has one module and a long flat
  /// list of sections, so the colour has to live at this level to be any use.
  color            String?
  /// When the section was added. Compared against a learner's completion date to
  /// name exactly what is new to them, rather than only that something is.
  createdAt        DateTime          @default(now())
  deletedAt        DateTime? // soft delete: recoverable from the admin dashboard
  /// Who last changed this as a draft, and when. See Module.lastEditedById.
  lastEditedById   Int?
  lastEditedAt     DateTime?
  lastEditedBy     User?             @relation("SectionEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)
  elements         Element[]
  quizzes          Quiz[]
  views            SectionProgress[]

  @@unique([courseId, number])
  @@index([courseId, sortKey])
  @@index([moduleId, position])
  @@index([lastEditedById])
}

model Element {
  id              String            @id @default(uuid())
  sectionId       String
  section         Section           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  order           Int // position within the section
  type            ElementType
  videoUrl        String? // for YOUTUBE type (the private/unlisted link)
  imageUrl        String? // for IMAGE type, when linked rather than uploaded
  imageData       String?           @db.Text // base64 of an uploaded image or PDF
  imageType       String? // MIME type of the uploaded file
  fileName        String? // original filename, shown for PDF downloads
  textContent     String? // for TEXT type
  /// Runtime of a YOUTUBE element, entered by the author. Summed for the
  /// "hours of video" figure on the course page.
  durationMinutes Int?
  /// Who last changed this as a draft, and when. See Module.lastEditedById.
  lastEditedById  Int?
  lastEditedAt    DateTime?
  lastEditedBy    User?             @relation("ElementEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)
  views           ElementProgress[]

  @@index([sectionId])
  @@index([lastEditedById])
}

enum ElementType {
  YOUTUBE
  IMAGE
  TEXT
  PDF
}

/// Sections auto-complete on view, so one row per user per section is all progress needs.
model SectionProgress {
  id        String   @id @default(uuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@unique([userId, sectionId])
  @@index([sectionId])
}

/// One piece of content a learner has opened.
///
/// Finer grained than SectionProgress on purpose: a sequential course unlocks item
/// by item, so "have they seen the thing before this one" has to be answerable
/// per element, not per section. Keyed on the element id rather than a position so
/// reordering or inserting content cannot silently re-lock what someone read.
model ElementProgress {
  id        String   @id @default(uuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  elementId String
  element   Element  @relation(fields: [elementId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@unique([userId, elementId])
  @@index([elementId])
}

model QuizAttempt {
  id          String       @id @default(uuid())
  userId      Int
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId      String
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  /// Always 0 for a LEARNING_CHECK: those are formative, and the rule is that the
  /// mark is never kept. What survives is the row itself, which is how the
  /// dashboard answers "did they attempt it".
  score       Int
  total       Int
  completedAt DateTime     @default(now())
  /// The paper itself, kept only for ONE_TIME quizzes — the admin dashboard shows
  /// what that person actually chose, and there is no retake to supersede it.
  answers     QuizAnswer[]

  @@index([userId, quizId])
  @@index([quizId])
}

/// One question as it was answered, frozen at submission time.
///
/// The prompt and option texts are copied rather than joined back to Question and
/// Option. A ONE_TIME quiz is a record of what somebody was asked and what they
/// said, and an author editing the quiz afterwards must not rewrite that.
model QuizAnswer {
  id         String      @id @default(uuid())
  attemptId  String
  attempt    QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  order      Int
  prompt     String      @db.Text
  /// What they picked, in the order the options were shown.
  chosen     String[]    @default([])
  /// What would have been right, so the answer reads without the quiz beside it.
  correct    String[]    @default([])
  wasCorrect Boolean     @default(false)

  @@index([attemptId])
}

/// Which of the three kinds of quiz this is. The kind decides where it may live,
/// whether it can be timed, whether the mark is kept, and who may see it.
enum QuizType {
  /// A formative check inside a section. Never timed, mark never stored, never
  /// listed on the Quizzes tab — but it must be attempted before the learner may
  /// move on to the next element.
  LEARNING_CHECK
  /// The ordinary graded quiz. Stands alone or sits in a section, may be timed,
  /// scores go to the dashboard, appears on the Quizzes tab.
  EXAM
  /// Sent as a one-off link. One attempt, then it disappears — and it is never
  /// listed on the Quizzes tab even for someone signed in with that address.
  ONE_TIME
}

// Quizzes are multiple choice or multiple answer: each Question has N Options and
// one or more of them is correct.
//
// A LEARNING_CHECK always belongs to a section. An EXAM may belong to one or stand
// alone. A ONE_TIME quiz always stands alone, because it is only ever reached
// through its link.
model Quiz {
  id                    String        @id @default(uuid())
  title                 String
  description           String?
  type                  QuizType      @default(EXAM)
  sectionId             String?
  section               Section?      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  /// Position within the section, sharing one sequence with Element.order so a
  /// quiz can sit between two pieces of content.
  order                 Int           @default(0)
  published             Boolean       @default(false) // hidden from learners until published
  /// Show the score screen — the ring and the percentage — after submitting.
  /// Off means the learner is moved straight on without being told how they did.
  showResults           Boolean       @default(true)
  showAnswers           Boolean       @default(false) // admin toggle: reveal correct answers after an attempt
  /// Whether an EXAM may be sat more than once.
  ///
  /// Off by default, which is what an exam means unless the author says
  /// otherwise: one sitting, one mark. On, and the learner is offered Try again
  /// on the result screen and when they come back to it later.
  ///
  /// Meaningless on the other two kinds and ignored there. A LEARNING_CHECK is
  /// always retakeable — it keeps no mark, so there is nothing to protect — and
  /// a ONE_TIME quiz never is, which is the whole of what it is for.
  allowMultipleAttempts Boolean       @default(false)
  dueDate               DateTime? // falls back to the course due date when not set
  /// Days the learner gets once this quiz is handed to them. Same idea as
  /// Course.daysRemaining, and read the same way when an assignment is made.
  daysRemaining         Int?
  /// Minutes a learner gets once they start. Null means untimed, and is forced
  /// for a LEARNING_CHECK.
  timeLimitMinutes      Int?
  /// Whether `type` may still be changed.
  ///
  /// Set the first time the quiz is published and never cleared. What a quiz is
  /// decides who can reach it and how, and changing that under a learner who
  /// already holds it is not an edit but a different quiz: an exam shared with
  /// somebody who has an account sits on their Quizzes tab, and switching it to
  /// a one-time link afterwards leaves it sitting there — listed, reachable, and
  /// the one thing a one-time link must never be. Publishing is the moment the
  /// choice stops being the author's alone, so it is the moment it is fixed.
  typeLocked            Boolean       @default(false)
  /// When the quiz was added, for the same reason as Section.createdAt.
  createdAt             DateTime      @default(now())
  deletedAt             DateTime? // soft delete: recoverable from the admin dashboard
  /// Who last changed this as a draft, and when. See Module.lastEditedById.
  lastEditedById        Int?
  lastEditedAt          DateTime?
  lastEditedBy          User?         @relation("QuizEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)
  questions             Question[]
  attempts              QuizAttempt[]
  sessions              QuizSession[]
  assignments           Assignment[]

  @@index([sectionId])
  @@index([type])
  @@index([lastEditedById])
}

/// One learner's run at a timed quiz.
///
/// The deadline is computed and stored server-side the moment they start, so the
/// clock is anchored to real time rather than to the page being open: closing the
/// tab and coming back resumes the same countdown, and nothing the browser sends
/// can extend it.
model QuizSession {
  id          String    @id @default(uuid())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId      String
  quiz        Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  /// Null when the quiz was untimed at the moment it was started.
  expiresAt   DateTime?
  /// Set once graded, whether the learner submitted or the clock ran out.
  submittedAt DateTime?

  @@index([userId, quizId])
}

model Question {
  id                String    @id @default(uuid())
  quizId            String
  quiz              Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  order             Int // position within the quiz
  prompt            String
  hint              String? // shown in a popup when the learner asks for a hint
  hintSectionNumber String? // optional section number the hint points back to, e.g. "1.2"
  /// Who last changed this as a draft, and when. See Module.lastEditedById.
  lastEditedById    Int?
  lastEditedAt      DateTime?
  lastEditedBy      User?     @relation("QuestionEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)
  options           Option[]

  @@index([quizId])
  @@index([lastEditedById])
}

model Option {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int // position within the question
  text       String
  isCorrect  Boolean  @default(false)

  @@index([questionId])
}

/// What one editing claim covers.
enum EditScope {
  /// A whole module, and everything inside it. Claimed while an author has that
  /// module open in the structure editor.
  MODULE
  /// One question in a quiz. Finer than a module on purpose — two people writing
  /// different questions in the same quiz is ordinary and should not block.
  QUESTION
}

/// Who currently has a piece of a course open, so two authors cannot silently
/// overwrite each other.
///
/// A claim rather than a lock in the database sense: it is advisory, held in a
/// row, and renewed by the editor that owns it every few seconds. That matters
/// because a browser can leave without saying so — a closed tab, a dead laptop,
/// a lost connection — and a lock nobody can release strands the content for
/// everyone else. A claim that has not been renewed inside `EDIT_LEASE_TTL_MS`
/// is simply ignored, and the next author to ask takes it over.
///
/// One row per target, which is what makes taking a claim a single upsert and
/// makes "who holds this" a single read. The holder is free to renew their own;
/// anybody else is refused until it lapses.
model EditLease {
  id        String    @id @default(uuid())
  courseId  String
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  scope     EditScope
  /// The module or question this covers.
  targetId  String
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  claimedAt DateTime  @default(now())
  /// Bumped by every heartbeat. A lease is live for as long as this is recent.
  renewedAt DateTime  @default(now())

  @@unique([scope, targetId])
  @@index([courseId, renewedAt])
  @@index([userId])
}
