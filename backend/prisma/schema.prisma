// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                Int                 @id @default(autoincrement())
  email             String              @unique
  /// Keycloak's fixed id for this person (the token's `sub`), set on their
  /// first sign-in. Identity is matched on this, never on the email alone: a
  /// Keycloak user can edit their own email, and matching on it would let them
  /// step into anyone else's record by typing that person's address.
  keycloakSubject   String?             @unique
  name              String?
  role              String?             @default("user")
  subscribed        Boolean             @default(false)
  /// When they last signed in through Keycloak.
  ///
  /// The only reliable mark of a real account. A User row is also created the
  /// moment someone is assigned work, so its mere existence proves nothing, and
  /// `name` cannot stand in for it — not every realm sends a name claim, which
  /// left genuine accounts looking like bare email addresses.
  lastSignInAt      DateTime?
  /// Where this person is in the first-login walkthrough.
  ///
  /// NOT_STARTED is what "first login" means: the tour starts the next time the
  /// app shell is shown to them. A row created by assigning work to an address
  /// that has never signed in starts here too, so the tour still greets them on
  /// their first real sign-in. Guests on a link keep this in their browser
  /// instead — see `tour-store.ts` — because a link is not an account.
  tourStatus        TourStatus          @default(NOT_STARTED)
  /// The step they were on, so a reload or another device resumes the tour
  /// where it was left. Bounded by TOUR_STEP_COUNT in `config/validation.ts`.
  tourStep          Int                 @default(0)
  sectionViews      SectionProgress[]
  quizAttempts      QuizAttempt[]
  quizSessions      QuizSession[]
  notes             Note[]
  completions       CourseCompletion[]
  /// Courses this person created. They own them: nobody else reaches them
  /// unless they are named on `editableCourses` below.
  authoredCourses   Course[]            @relation("CourseAuthor")
  /// Courses this person may edit. Empty means no Course Editor access.
  editableCourses   Course[]            @relation("CourseContributors")
  /// Assignments this person handed out. Their address is the one the learner
  /// hears from, so a reply lands with whoever set the work.
  assignmentsMade   Assignment[]        @relation("AssignmentAssigner")
  /// Course versions this person put live, for the archive list.
  publishedVersions CoursePublication[] @relation("PublishedVersions")
  /// Versions this person marked to be kept for good.
  archivedVersions  CoursePublication[] @relation("ArchivedVersions")
  /// What this person currently has open for editing, so two authors in one
  /// course do not overwrite each other. At most a handful of rows at a time.
  editLeases        EditLease[]
  /// Draft edits credited to this person. Cleared when the course is published,
  /// because at that point there is no unpublished change left to attribute.
  editedModels      Model[]             @relation("ModelEditor")
  editedSections    Section[]           @relation("SectionEditor")
  editedQuizzes     Quiz[]              @relation("QuizEditor")
  editedQuestions   Question[]          @relation("QuestionEditor")
  /// Which branches of a directed course this person picked, per layer.
  directedChoices   DirectedChoice[]
}

/// Where someone is in the first-login walkthrough.
enum TourStatus {
  /// Never shown. The tour starts on their next visit to the app shell.
  NOT_STARTED
  /// Part way through; `User.tourStep` says where.
  IN_PROGRESS
  /// Reached the last step.
  COMPLETED
  /// Turned it down. Remembered exactly like finishing, and undone the same way:
  /// Replay tour on the Profile page.
  SKIPPED
}

/// What kind of thing a Course is.
///
/// Both are the same shape — models holding sections, each section one piece
/// of content — and
/// share publishing, versioning, access and the whole learner path. They differ
/// only in what an author is offered while editing one, and in which tab it
/// appears under.
enum CourseKind {
  /// A lesson: sections of text, video, pictures and files, with quiz sections
  /// dropped in among them.
  LESSON
  /// A quiz set: one model, and a QUIZ section per quiz. Nothing else.
  QUIZ_SET
}

/// The top-level container an admin creates by name, then fills with content.
model Course {
  id                String     @id @default(uuid())
  title             String
  /// Lesson or quiz set. Decides which tab lists it and what the editor offers.
  kind              CourseKind @default(LESSON)
  /// One-line pitch shown under the title on the course page.
  shortDescription  String?
  /// The long description shown further down the course page.
  description       String?
  tags              String[]   @default([])
  languages         String[]   @default([])
  /// Bullet points for the "What you'll learn" box.
  whatYouWillLearn  String[]   @default([])
  prerequisites     String[]   @default([])
  required          Boolean    @default(false) // required learning
  dueDate           DateTime? // when required learning must be finished
  /// How long someone gets once this is handed to them, in days.
  ///
  /// The deadline an author sets is a length rather than a date: a course
  /// assigned today and the same course assigned next month should each give
  /// the learner the same run at it, which one fixed `dueDate` cannot do. The
  /// assignment's own `dueDate` is stamped from this at the moment it is made —
  /// see AssignmentService.assign — and `dueDate` above stays as the single
  /// course-wide deadline for anything that never went through an assignment.
  daysRemaining     Int?
  published         Boolean    @default(false) // hidden from learners until published
  /// When on, a section stays locked until every earlier section is finished.
  sequential        Boolean    @default(false)
  /// Whether the deadline shuts the course, or only reports that it passed.
  ///
  /// On, and once the due date has gone the learner cannot open anything: the
  /// way in is closed and the quizzes inside refuse to start. That is right for
  /// a compliance course, where sitting it late is the same as not sitting it.
  ///
  /// Off, and the deadline is a date rather than a gate — the course still says
  /// it is overdue, everywhere it said so before, but the learner may carry on
  /// and finish. That is right for most learning, where a week late is worth far
  /// more than never.
  ///
  /// On by default, because that is what a deadline meant here before this was
  /// a choice, and quietly opening every existing course would be a change
  /// nobody asked for.
  lockAfterDue      Boolean    @default(true)
  /// Whether this course's path is built from a map rather than read straight
  /// through.
  ///
  /// Off is the ordinary course, and off is what every course that existed
  /// before this column is: the mapping tab is hidden, the staging step does not
  /// apply, and publishing asks nothing new. On, and the sections authored in
  /// the Models tab are delivered through `mapNodes` instead — each learner
  /// gets the branches they picked at the generated quizzes, so two people on
  /// the same course can read entirely different content.
  ///
  /// Only meaningful on a LESSON. A quiz set has one model and a section per
  /// quiz; there is no path through it to direct.
  directedLearning  Boolean    @default(false)
  /// The one course every account and every link holder has without being
  /// assigned it: the guide the first-login walkthrough hands people into.
  ///
  /// At most one course carries this — a partial unique index in the migration
  /// enforces it, since Prisma cannot declare one — and it is created on start-up
  /// by `DefaultTutorialService.ensure` rather than by the seed, which production
  /// never runs. It cannot be deleted, unpublished or assigned, and only admins
  /// may edit it; see `DefaultTutorialService` for each of those rules.
  isDefaultTutorial Boolean    @default(false)
  /// When the content was last staged to the map, or null if never.
  ///
  /// Staging is the soft publish between writing content and mapping it: it
  /// settles the root node, refreshes the layer quizzes from the map as it
  /// stands, and is what puts newly written sections in front of the person
  /// doing the mapping. Nothing about it reaches a learner — that is still
  /// `publish`.
  stagedAt          DateTime?
  /// The models and sections that existed when the course was last staged.
  ///
  /// Mapping is refused while anything has been added since: the staging pool
  /// and the map would otherwise disagree about what there is to place. Ids
  /// rather than a count, so adding one section and deleting another still
  /// reads as "something new to stage".
  stagedContentIds  String[]   @default([])
  publishedAt       DateTime? // stamped the first time it is published
  /// Which CoursePublication learners are currently served. 0 means the course
  /// has never been published, so there is nothing for a learner to read.
  ///
  /// Authors edit the live rows below freely; none of it reaches a learner until
  /// a publish snapshots it. That is what lets an edit to existing content be
  /// held back as surely as a brand new section.
  publishedVersion  Int        @default(0)
  /// Touched by every content edit. Compared against the current publication's
  /// date to answer "are there unpublished changes?" without diffing the tree.
  draftUpdatedAt    DateTime   @default(now())
  imageData         String?    @db.Text // base64 cover photo shown on the Learning page
  imageType         String? // MIME type of the cover photo
  deletedAt         DateTime? // soft delete: recoverable from the admin dashboard
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @default(now()) @updatedAt
  /// Bumped only when a section or quiz is added. Compared against a learner's
  /// completion date to tell them there is something new.
  contentUpdatedAt  DateTime   @default(now())
  /// Who made this, and so who owns it.
  ///
  /// Authoring rights used to follow from the Keycloak role alone, which made
  /// every admin an author of everything: one person's draft sat on every other
  /// admin's Create a Lesson page, ready to be edited or deleted. Ownership is
  /// recorded here instead, and `contributors` below is how it is shared — so a
  /// course is reachable by the person who made it and by whoever they named,
  /// and by nobody else whatever role they hold.
  ///
  /// Null on courses that predate this column and could not be attributed to
  /// anyone (see the backfill in the migration). Those stay visible to global
  /// authors, because otherwise they would belong to nobody and be unreachable.
  createdById       Int?
  createdBy         User?      @relation("CourseAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  models          Model[]
  sections        Section[]
  completions     CourseCompletion[]
  /// People allowed to edit this one course without being global authors.
  contributors    User[]                @relation("CourseContributors")
  instructors     Instructor[]
  notes           Note[]
  assignments     Assignment[]
  publications    CoursePublication[]
  /// Who currently has a model or a question in this course open.
  editLeases      EditLease[]
  /// The directed-learning map: its nodes, the connections between them, and the
  /// quiz generated for each layer. Empty on every course that is not directed.
  mapNodes        CourseMapNode[]
  mapEdges        CourseMapEdge[]
  mapImports      CourseMapImport[]     @relation("MapImportOwner")
  /// Maps that offer this course's sections as importable content.
  mapImportedBy   CourseMapImport[]     @relation("MapImportSource")
  layerQuizzes    DirectedLayerQuiz[]
  directedChoices DirectedChoice[]
  /// Other courses' maps linked into this one, and this map linked into others.
  mapSubgraphs    CourseMapSubgraph[]   @relation("SubgraphOwner")
  mapLinkedInto   CourseMapSubgraph[]   @relation("SubgraphSource")
  /// The items every new canvas in this course starts with. See CourseCanvasTemplate.
  canvasTemplate  CourseCanvasTemplate?

  @@index([kind])
  @@index([createdById])
}

/// One published version of a course, frozen at the moment it went live.
///
/// The whole course tree is stored as JSON rather than as a second set of rows.
/// Two reasons. Progress is keyed on section and quiz ids, and those
/// have to stay stable across a publish or every learner's history would break —
/// copying rows would mint new ids. And authors get to keep editing the live
/// tables exactly as before, with no draft/live pair on every column: the
/// snapshot is what a learner reads, so an unpublished edit is invisible for
/// free.
///
/// The cost is that snapshots carry their sections' base64 media, so they are
/// large. That is bounded by the retention sweep, which keeps only the live
/// version and whatever was superseded inside the archive window.
/// The items an author marked as defaults for new canvases in one course.
///
/// Its own table rather than a column on Course because it carries pictures as
/// base64, and Course rows are read whole all over the app — a column would
/// drag megabytes into every course listing. Only the canvas editor and the
/// creation of a new canvas ever read it.
///
/// `data` is { items, images } in the same shape as a canvas's own JSON (see
/// backend/src/config/canvas.ts). Items keep the id of the item they were copied
/// from, which is how the editor knows a selected item is already a default.
model CourseCanvasTemplate {
  courseId  String   @id
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  data      Json
  updatedAt DateTime @updatedAt
}

model CoursePublication {
  id            String    @id @default(uuid())
  courseId      String
  course        Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// 1-based, and the number Course.publishedVersion points at.
  version       Int
  /// The course tree as learners see it at this version.
  snapshot      Json
  publishedAt   DateTime  @default(now())
  publishedById Int?
  publishedBy   User?     @relation("PublishedVersions", fields: [publishedById], references: [id], onDelete: SetNull)
  /// Set when a newer version replaced this one. Null on the live version, which
  /// is never purged however old it gets.
  supersededAt  DateTime?
  /// Set when someone deliberately kept this version for good.
  ///
  /// The ordinary archive is a grace period: a replaced version is readable for
  /// fourteen days and then cleared, which is right for the dozens of versions
  /// nobody will ever look at again. This is the escape hatch for the few that
  /// matter — the one that was audited, the one signed off — and a row with this
  /// set is never touched by the purge however long ago it was replaced.
  ///
  /// Clearing it does not delete the version: it drops back into the ordinary
  /// history, and the fourteen days start from that moment rather than from the
  /// publish it was replaced by, so keeping something and then changing your
  /// mind never destroys it on the spot.
  archivedAt    DateTime?
  archivedById  Int?
  archivedBy    User?     @relation("ArchivedVersions", fields: [archivedById], references: [id], onDelete: SetNull)

  /// What this version added compared with the one before it, so a learner who
  /// had already finished can be shown exactly what is new. Worked out once at
  /// publish time rather than by diffing two snapshots on every page load.
  newModelIds   String[] @default([])
  newSectionIds String[] @default([])
  newQuizIds    String[] @default([])

  @@unique([courseId, version])
  @@index([courseId, publishedAt])
  @@index([supersededAt])
  @@index([archivedById])
}

/// Someone credited on a course. Courses can list more than one.
model Instructor {
  id        String   @id @default(uuid())
  name      String
  /// Job title or role, shown under the name.
  title     String?
  bio       String?  @db.Text
  photoData String?  @db.Text
  photoType String?
  createdAt DateTime @default(now())
  courses   Course[]
}

/// Which of the two ways a piece of content was handed to someone.
enum AssignmentType {
  /// Enrolled on the platform. They sign in with this email and find the course
  /// in their Learning tab; the token is never published to them.
  PLATFORM
  /// Sent as a direct link. The token in the URL is the credential and no login
  /// is involved. Deliberately invisible to the same person when signed in, so a
  /// one-off link never turns into a permanent enrolment.
  LINK
}

/// A course or quiz handed to someone by email.
///
/// One assignment is one course or one quiz, and a LINK assignment's URL opens
/// exactly that — someone given three courses gets three separate links. For a
/// LINK the token IS the credential: anyone holding it acts as `email`. Progress
/// is recorded against the User row for that address either way, so a guest who
/// later signs in through Keycloak with the same email keeps their history.
model Assignment {
  id                String         @id @default(uuid())
  type              AssignmentType @default(LINK)
  /// SHA-256 (hex) of the link's token. The token itself appears only in the
  /// URL that is emailed or copied, and is never stored: a copy of this table
  /// must not be a working key to every guest's training. A link can be
  /// re-issued, which replaces this and turns the old URL off.
  tokenHash         String         @unique
  email             String
  courseId          String?
  course            Course?        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quizId            String?
  quiz              Quiz?          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  /// Who handed this over. Their address is used as the From and Reply-To on
  /// every mail about it, so the learner answers a person rather than a system
  /// mailbox. Null on rows created before assignments recorded this.
  assignedById      Int?
  assignedBy        User?          @relation("AssignmentAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedAt        DateTime       @default(now())
  dueDate           DateTime?
  /// Optional cut-off; the link stops working after this.
  expiresAt         DateTime?
  /// Set to kill a link early without deleting the record.
  revokedAt         DateTime?
  /// Stamped when a ONE_TIME quiz behind this link has been handed in. The quiz
  /// is closed from that moment; the link stays open for exactly one more visit,
  /// so the holder can come back to their result rather than to a bare error.
  completedAt       DateTime?
  /// Stamped the first time the link is opened *after* it was completed — the one
  /// visit that shows the result. Opening it again after this closes the link for
  /// good, which is what `revokedAt` then records. Kept apart from
  /// `lastAccessedAt` because that moves on every request, and a single page load
  /// makes several.
  resultsSeenAt     DateTime?
  lastAccessedAt    DateTime?
  /// When the notification email actually went out. Null means it was never sent
  /// — no mail credentials configured, or the send failed.
  notifiedAt        DateTime?
  /// Mails sent about this assignment inside the current window. Together with
  /// `notifyWindowStart` this is the whole rate limit: flipping the link off and
  /// on again re-sends, but only so many times before it refuses.
  notifyCount       Int            @default(0)
  notifyWindowStart DateTime?

  @@index([email])
  @@index([courseId])
  @@index([quizId])
  @@index([assignedById])
}

/// Stamped the first time a learner reaches 100% of a course.
///
/// Kept separate from progress because progress answers "how far are they", while
/// this answers "had they finished before this content appeared" — which is what
/// makes a new-content notice meaningful rather than noise.
model CourseCompletion {
  id           String    @id @default(uuid())
  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId     String
  course       Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  completedAt  DateTime  @default(now())
  /// What they finished, so the notice can say how much is new.
  sectionCount Int       @default(0)
  /// When they were last emailed that this course had gained content. Stops a
  /// burst of edits turning into a burst of mail.
  notifiedAt   DateTime?

  @@unique([userId, courseId])
}

/// A learner's own notes, kept per course and optionally pinned to a section.
model Note {
  id        String   @id @default(uuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sectionId String?
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId, courseId])
  @@index([sectionId])
}

/// A named group of sections, and the first digit of every section number inside it.
///
/// Course structure is a two-dimensional grid: the model is the outer index and
/// the section its inner one, so model 2's third section is "2.3". `number` is the
/// model's 1-based place in the course, which the author sets directly.
model Model {
  id             String             @id @default(uuid())
  courseId       String
  course         Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  number         Int
  title          String
  /// Hex tint the author picked, e.g. "#c7d9f0". Used at low opacity behind the
  /// model's sections so a long course reads as groups at a glance. Null means
  /// no tint, which is the default.
  color          String?
  deletedAt      DateTime? // soft delete: recoverable from the admin dashboard
  /// Who last changed this while it was still a draft, and when.
  ///
  /// Cleared for the whole course at publish time, because the question these
  /// answer is "what has changed that learners cannot see yet, and who did it" —
  /// once it is published there is no such change left to attribute, and leaving
  /// the marks up would tag every course forever.
  lastEditedById Int?
  lastEditedAt   DateTime?
  lastEditedBy   User?              @relation("ModelEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)
  sections       Section[]
  /// Set when this model is the auto-managed home of a layer quiz. Such a
  /// model is written by the map and is read-only in the structure editor.
  layer          DirectedLayerQuiz?

  @@unique([courseId, number])
  @@index([courseId, number])
  @@index([lastEditedById])
}

/// One piece of a course, living inside a model.
///
/// A course has two layers: models, and the sections inside them. A section is
/// the content itself — one text, one video, one picture, one PDF, one canvas or
/// one quiz — and `type` says which. There is no layer underneath it: what used
/// to be a list of elements inside a section is now a run of sections.
///
/// `position` is the section's 1-based place within its model — the digit after
/// the dot. `number` ("2.3") and `sortKey` (zero-padded, so "1.10" sorts after
/// "1.2") are derived from model.number and position and stored so ordering and
/// display cost nothing to read. Never set them by hand: they are rewritten
/// wholesale by the renumbering pass in CurriculumService.
model Section {
  id               String            @id @default(uuid())
  courseId         String
  course           Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  modelId          String?
  model            Model?            @relation(fields: [modelId], references: [id], onDelete: Cascade)
  position         Int               @default(1)
  number           String
  sortKey          String
  title            String
  /// What this section is. Chosen when it is created and required there: it has
  /// no default on purpose, so a section cannot exist without saying what it
  /// holds.
  type             SectionType
  estimatedMinutes Int               @default(0) // admin's estimate; summed for the course total
  /// Hex tint the author picked, from the same closed palette a model uses.
  ///
  /// Models already carried one, which was enough while a section was only ever
  /// read inside its model's group. A quiz set has one model and a long flat
  /// list of sections, so the colour has to live at this level to be any use.
  color            String?
  videoUrl         String? // for YOUTUBE type (the private/unlisted link)
  imageUrl         String? // for IMAGE type, when linked rather than uploaded
  imageData        String?           @db.Text // base64 of an uploaded image or PDF
  imageType        String? // MIME type of the uploaded file
  fileName         String? // original filename, shown for PDF downloads
  textContent      String? // for TEXT type
  /// For CANVAS type: the layout (pictures, text boxes, shapes) and the pool of
  /// uploaded pictures it draws from. Shape in src/config/canvas.ts.
  canvasData       Json?
  /// Runtime of a YOUTUBE section, entered by the author. Summed for the
  /// "hours of video" figure on the course page.
  durationMinutes  Int?
  /// When the section was added. Compared against a learner's completion date to
  /// name exactly what is new to them, rather than only that something is.
  createdAt        DateTime          @default(now())
  deletedAt        DateTime? // soft delete: recoverable from the course's Archive tab
  /// Who last changed this as a draft, and when. See Model.lastEditedById.
  lastEditedById   Int?
  lastEditedAt     DateTime?
  lastEditedBy     User?             @relation("SectionEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)
  /// The quiz of a QUIZ section. A list because the column lives on Quiz, but a
  /// QUIZ section holds exactly one and every other type holds none —
  /// CurriculumService and QuizService keep that true.
  quizzes          Quiz[]
  views            SectionProgress[]
  /// Where this section sits on a course map — its own course's, or another
  /// course's that imported it.
  mapPlacements    CourseMapItem[]

  @@unique([courseId, number])
  @@index([courseId, sortKey])
  @@index([modelId, position])
  @@index([lastEditedById])
}

/// What one section holds.
enum SectionType {
  YOUTUBE
  IMAGE
  TEXT
  PDF
  CANVAS
  /// A quiz. The Quiz row hangs off the section through `Quiz.sectionId`.
  QUIZ
}

/// One row per user per section they have opened.
///
/// This is the whole of content progress now that a section is a single piece
/// of content: a sequential course unlocks section by section, and "have they
/// seen the thing before this one" is answered here. Keyed on the section id
/// rather than a position so reordering or inserting content cannot silently
/// re-lock what someone read.
model SectionProgress {
  id        String   @id @default(uuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@unique([userId, sectionId])
  @@index([sectionId])
}

model QuizAttempt {
  id          String       @id @default(uuid())
  userId      Int
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId      String
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  /// Always 0 for a LEARNING_CHECK: those are formative, and the rule is that the
  /// mark is never kept. What survives is the row itself, which is how the
  /// dashboard answers "did they attempt it".
  score       Int
  total       Int
  completedAt DateTime     @default(now())
  /// The paper itself, kept only for ONE_TIME quizzes — the admin dashboard shows
  /// what that person actually chose, and there is no retake to supersede it.
  answers     QuizAnswer[]

  @@index([userId, quizId])
  @@index([quizId])
}

/// One question as it was answered, frozen at submission time.
///
/// The prompt and option texts are copied rather than joined back to Question and
/// Option. A ONE_TIME quiz is a record of what somebody was asked and what they
/// said, and an author editing the quiz afterwards must not rewrite that.
model QuizAnswer {
  id         String      @id @default(uuid())
  attemptId  String
  attempt    QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  order      Int
  prompt     String      @db.Text
  /// What they picked, in the order the options were shown.
  chosen     String[]    @default([])
  /// What would have been right, so the answer reads without the quiz beside it.
  correct    String[]    @default([])
  wasCorrect Boolean     @default(false)

  @@index([attemptId])
}

/// Which of the three kinds of quiz this is. The kind decides where it may live,
/// whether it can be timed, whether the mark is kept, and who may see it.
enum QuizType {
  /// A formative check inside a lesson. Never timed, mark never stored, never
  /// listed on the Quizzes tab — but it must be attempted before the learner may
  /// move on to the next section.
  LEARNING_CHECK
  /// The ordinary graded quiz. Stands alone or sits in a section, may be timed,
  /// scores go to the dashboard, appears on the Quizzes tab.
  EXAM
  /// Sent as a one-off link. One attempt, then it disappears — and it is never
  /// listed on the Quizzes tab even for someone signed in with that address.
  ONE_TIME
  /// The layer quiz of a directed course, asking which branches apply to this
  /// learner. Generated from the course map and never chosen by an author — it
  /// is the one kind that cannot be created, retyped or deleted by hand, because
  /// the map is what it is made of.
  ///
  /// Never timed and never scored: "which of these apply to you" has no right
  /// answer, so the mark is meaningless and what is kept is the choice itself,
  /// in DirectedChoice. Always retakeable, because changing your mind about what
  /// you need to learn is the whole point of asking.
  DIRECTED
}

// Quizzes are multiple choice or multiple answer: each Question has N Options and
// one or more of them is correct.
//
// A LEARNING_CHECK always belongs to a section. An EXAM may belong to one or stand
// alone. A ONE_TIME quiz always stands alone, because it is only ever reached
// through its link.
model Quiz {
  id                    String             @id @default(uuid())
  title                 String
  description           String?
  type                  QuizType           @default(EXAM)
  sectionId             String?
  section               Section?           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  /// Unused for a quiz in a course: its place is its section's `position`. Kept
  /// for the older quizzes that stand alone.
  order                 Int                @default(0)
  published             Boolean            @default(false) // hidden from learners until published
  /// Show the score screen — the ring and the percentage — after submitting.
  /// Off means the learner is moved straight on without being told how they did.
  showResults           Boolean            @default(true)
  showAnswers           Boolean            @default(false) // admin toggle: reveal correct answers after an attempt
  /// Whether an EXAM may be sat more than once.
  ///
  /// Off by default, which is what an exam means unless the author says
  /// otherwise: one sitting, one mark. On, and the learner is offered Try again
  /// on the result screen and when they come back to it later.
  ///
  /// Meaningless on the other two kinds and ignored there. A LEARNING_CHECK is
  /// always retakeable — it keeps no mark, so there is nothing to protect — and
  /// a ONE_TIME quiz never is, which is the whole of what it is for.
  allowMultipleAttempts Boolean            @default(false)
  dueDate               DateTime? // falls back to the course due date when not set
  /// Days the learner gets once this quiz is handed to them. Same idea as
  /// Course.daysRemaining, and read the same way when an assignment is made.
  daysRemaining         Int?
  /// Minutes a learner gets once they start. Null means untimed, and is forced
  /// for a LEARNING_CHECK.
  timeLimitMinutes      Int?
  /// Whether `type` may still be changed.
  ///
  /// Set the first time the quiz is published and never cleared. What a quiz is
  /// decides who can reach it and how, and changing that under a learner who
  /// already holds it is not an edit but a different quiz: an exam shared with
  /// somebody who has an account sits on their Quizzes tab, and switching it to
  /// a one-time link afterwards leaves it sitting there — listed, reachable, and
  /// the one thing a one-time link must never be. Publishing is the moment the
  /// choice stops being the author's alone, so it is the moment it is fixed.
  typeLocked            Boolean            @default(false)
  /// When the quiz was added, for the same reason as Section.createdAt.
  createdAt             DateTime           @default(now())
  deletedAt             DateTime? // soft delete: recoverable from the admin dashboard
  /// Who last changed this as a draft, and when. See Model.lastEditedById.
  lastEditedById        Int?
  lastEditedAt          DateTime?
  lastEditedBy          User?              @relation("QuizEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)
  questions             Question[]
  attempts              QuizAttempt[]
  sessions              QuizSession[]
  assignments           Assignment[]
  /// Set only on a DIRECTED quiz: the map layer it was generated for.
  layer                 DirectedLayerQuiz?

  @@index([sectionId])
  @@index([type])
  @@index([lastEditedById])
}

/// One learner's run at a timed quiz.
///
/// The deadline is computed and stored server-side the moment they start, so the
/// clock is anchored to real time rather than to the page being open: closing the
/// tab and coming back resumes the same countdown, and nothing the browser sends
/// can extend it.
model QuizSession {
  id          String    @id @default(uuid())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId      String
  quiz        Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  /// Null when the quiz was untimed at the moment it was started.
  expiresAt   DateTime?
  /// Set once graded, whether the learner submitted or the clock ran out.
  submittedAt DateTime?

  @@index([userId, quizId])
}

model Question {
  id                String    @id @default(uuid())
  quizId            String
  quiz              Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  order             Int // position within the quiz
  prompt            String
  hint              String? // shown in a popup when the learner asks for a hint
  hintSectionNumber String? // optional section number the hint points back to, e.g. "1.2"
  /// Who last changed this as a draft, and when. See Model.lastEditedById.
  lastEditedById    Int?
  lastEditedAt      DateTime?
  lastEditedBy      User?     @relation("QuestionEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)
  options           Option[]

  @@index([quizId])
  @@index([lastEditedById])
}

model Option {
  id         String         @id @default(uuid())
  questionId String
  question   Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int // position within the question
  text       String
  isCorrect  Boolean        @default(false)
  /// Set only inside a layer quiz: the connection this option offers. Ticking it
  /// is what selects that child node for this learner.
  mapEdge    CourseMapEdge?

  @@index([questionId])
}

/// What one editing claim covers.
enum EditScope {
  /// A whole model, and everything inside it. Claimed while an author has that
  /// model open in the structure editor.
  MODEL
  /// One question in a quiz. Finer than a model on purpose — two people writing
  /// different questions in the same quiz is ordinary and should not block.
  QUESTION
}

/// Who currently has a piece of a course open, so two authors cannot silently
/// overwrite each other.
///
/// A claim rather than a lock in the database sense: it is advisory, held in a
/// row, and renewed by the editor that owns it every few seconds. That matters
/// because a browser can leave without saying so — a closed tab, a dead laptop,
/// a lost connection — and a lock nobody can release strands the content for
/// everyone else. A claim that has not been renewed inside `EDIT_LEASE_TTL_MS`
/// is simply ignored, and the next author to ask takes it over.
///
/// One row per target, which is what makes taking a claim a single upsert and
/// makes "who holds this" a single read. The holder is free to renew their own;
/// anybody else is refused until it lapses.
model EditLease {
  id        String    @id @default(uuid())
  courseId  String
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  scope     EditScope
  /// The model or question this covers.
  targetId  String
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  claimedAt DateTime  @default(now())
  /// Bumped by every heartbeat. A lease is live for as long as this is recent.
  renewedAt DateTime  @default(now())

  @@unique([scope, targetId])
  @@index([courseId, renewedAt])
  @@index([userId])
}

/// One box on a directed course's map.
///
/// A node is a container the author makes and names, holding an ordered list of
/// sections — its own course's, or ones imported from another course they may
/// edit. It is not a piece of content itself: the content is `items`, and what
/// the node contributes is the *question of whether a learner needs them*.
///
/// The root is the one node every mapped course has and nobody makes. It has no
/// parents and can never be given any, which is what makes it the place every
/// learner starts, and it is not deletable.
model CourseMapNode {
  id           String             @id @default(uuid())
  courseId     String
  course       Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title        String
  /// Where the box sits on the canvas.
  ///
  /// Not decoration. `x` is also the learner's reading order among everything at
  /// the same depth — the course runs left to right and top to bottom of the
  /// tree exactly as it is drawn — so moving a box is an edit to the course, not
  /// to the picture of it.
  x            Int
  y            Int
  /// Jumps from the root, and so which layer quiz offers this node.
  ///
  /// One more than its *shallowest* parent, because a node reachable by a short
  /// path should be offered as soon as that path allows rather than held back
  /// for a longer one. Derived from the edges and stored: ordering the whole
  /// course reads it on every page load, and walking the graph each time to
  /// re-derive it would cost the same read many times over.
  depth        Int                @default(0)
  /// True on the one node the map starts from. See the note above.
  isRoot       Boolean            @default(false)
  /// Set when this node is a copy of another course's node, brought in as part
  /// of a linked map. Such a node is read-only here and is kept in step with
  /// `sourceNodeId` whenever the source course's map changes.
  subgraphId   String?
  subgraph     CourseMapSubgraph? @relation("SubgraphNodes", fields: [subgraphId], references: [id], onDelete: Cascade)
  sourceNodeId String?

  /// Connections into this node, and out of it.
  parents           CourseMapEdge[]     @relation("EdgeChild")
  children          CourseMapEdge[]     @relation("EdgeParent")
  items             CourseMapItem[]
  /// Linked maps hung off this node — it stands in for their root.
  anchoredSubgraphs CourseMapSubgraph[] @relation("SubgraphAnchor")

  @@unique([subgraphId, sourceNodeId])
  @@index([courseId, depth])
}

/// One parent-to-child connection, and the quiz option that offers it.
///
/// A separate row rather than a `parentId` column because a node may hang off
/// more than one parent — site safety training belongs under every project that
/// happens on site, and duplicating it would split one person's progress across
/// two copies. The option lives here rather than on the node for the same
/// reason: a node with two parents is offered twice in its layer quiz, once per
/// route in, and ticking either is what brings it in.
model CourseMapEdge {
  id         String             @id @default(uuid())
  courseId   String
  course     Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  parentId   String
  parent     CourseMapNode      @relation("EdgeParent", fields: [parentId], references: [id], onDelete: Cascade)
  childId    String
  child      CourseMapNode      @relation("EdgeChild", fields: [childId], references: [id], onDelete: Cascade)
  /// The option in the child's layer quiz that selects it through this route.
  /// Rewritten by the generator; null only between an edge being drawn and the
  /// quizzes being regenerated.
  optionId   String?            @unique
  option     Option?            @relation(fields: [optionId], references: [id], onDelete: SetNull)
  /// Set when this connection belongs to a linked map, which fixes it in place.
  subgraphId String?
  subgraph   CourseMapSubgraph? @relation(fields: [subgraphId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId])
  @@index([courseId])
  @@index([childId])
}

/// One section pinned to a node, in order.
///
/// `sourceCourseId` is what tells an imported section from one of the course's
/// own, which the publish gate needs: every section of *this* course must be on
/// the map before it may go out, while an imported course is a shelf to take
/// three sections off and leave the fourth.
model CourseMapItem {
  id             String             @id @default(uuid())
  nodeId         String
  node           CourseMapNode      @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  order          Int
  sectionId      String
  section        Section            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sourceCourseId String
  /// Set when this placement was written by a linked map rather than the author.
  subgraphId     String?
  subgraph       CourseMapSubgraph? @relation(fields: [subgraphId], references: [id], onDelete: Cascade)

  @@unique([nodeId, sectionId])
  @@index([sectionId])
  @@index([sourceCourseId])
}

/// Another course whose sections this map may draw on.
///
/// Importing is how a course reuses training that already exists somewhere else
/// rather than copying it in: the sections stay owned and edited by their own
/// course, and this map only places them. Only courses the importer created or
/// is named on can be added, and the imported course stays read-only here — it
/// is edited in its own editor or not at all.
model CourseMapImport {
  id             String @id @default(uuid())
  courseId       String
  course         Course @relation("MapImportOwner", fields: [courseId], references: [id], onDelete: Cascade)
  sourceCourseId String
  sourceCourse   Course @relation("MapImportSource", fields: [sourceCourseId], references: [id], onDelete: Cascade)
  /// Where this course sits in the staging manager, under the importing course's
  /// own content.
  order          Int    @default(0)

  @@unique([courseId, sourceCourseId])
  @@index([sourceCourseId])
}

/// Another course's whole map, linked into this one as a fixed piece.
///
/// Made when content from an imported course that is itself mapped is dropped
/// onto a node. Every source node is copied in, its root included, with the
/// source's connections between them (drawn red). The copy is read-only here —
/// the source course owns it — and is rewritten whenever the source's map
/// changes, so both courses stay in step. This course's own nodes may lead into
/// the copy's root, and on from any copy node with no children of its own.
/// Deleting any node of the copy removes the whole link.
model CourseMapSubgraph {
  id             String          @id @default(uuid())
  courseId       String
  course         Course          @relation("SubgraphOwner", fields: [courseId], references: [id], onDelete: Cascade)
  sourceCourseId String
  sourceCourse   Course          @relation("SubgraphSource", fields: [sourceCourseId], references: [id], onDelete: Cascade)
  /// The node it was dropped on, until the first sync connects that node to the
  /// copy's root and clears this. Also how links made before the root was
  /// copied in are recognised and converted.
  anchorNodeId   String?
  anchorNode     CourseMapNode?  @relation("SubgraphAnchor", fields: [anchorNodeId], references: [id], onDelete: SetNull)
  nodes          CourseMapNode[] @relation("SubgraphNodes")
  edges          CourseMapEdge[]
  items          CourseMapItem[]

  @@unique([courseId, sourceCourseId])
  @@index([sourceCourseId])
  @@index([anchorNodeId])
}

/// The generated quiz for one layer of a map, and the model it lives in.
///
/// One per depth rather than one per parent: everything the same number of jumps
/// from the root is asked about together, in a single question, so a learner
/// answers "what applies to me at this level" once instead of once per branch
/// they happen to have taken.
model DirectedLayerQuiz {
  id       String @id @default(uuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// The depth this quiz asks about — the depth of the nodes it offers, so the
  /// model reads "Directed learning quiz 1" for the root's children.
  depth    Int
  quizId   String @unique
  quiz     Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  /// The auto-managed model the quiz sits in. Written by the map generator and
  /// read-only in the structure editor.
  modelId  String @unique
  model    Model  @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([courseId, depth])
}

/// Which branches one learner picked at one layer quiz.
///
/// Kept apart from QuizAnswer, which freezes what somebody was asked and what
/// they said and is never rewritten. This is not a record of a sitting: it is
/// the learner's current path, overwritten every time they retake, and read on
/// every load of the course to decide what they are served.
///
/// Deselecting removes content from their course and touches no progress row, so
/// someone who drops a branch and later takes it back finds their training
/// exactly where they left it.
model DirectedChoice {
  id            String   @id @default(uuid())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  depth         Int
  /// The nodes they ticked, by id. Node ids rather than option ids because a
  /// node offered by two parents has two options and either one means the same
  /// thing, and because an edge redrawn by the author must not lose an answer.
  chosenNodeIds String[] @default([])
  answeredAt    DateTime @default(now())

  @@unique([userId, courseId, depth])
  @@index([courseId])
}
