NODE_ENV="development"

# How much of the X-Forwarded-For chain to believe when working out the caller's
# IP address (used by the public-endpoint rate limiter).
#
# Leave unset locally: there is no proxy in front of the container, so the direct
# socket address is already correct.
#
# In production the chain is Cloudflare -> k8s ingress -> backend, so set this to
# the number of proxy hops, e.g. TRUST_PROXY=2. Confirm the real number against
# the ingress config before deploying: too low and you rate-limit the proxy
# instead of the visitor, too high and the value becomes caller-controlled.
# Avoid TRUST_PROXY=true — it trusts a header anyone can forge.
TRUST_PROXY=

# Prisma database connection
# Note: this file is neccessary for locally running backend (not using docker)
DATABASE_URL="postgresql://CHANGE_ME:CHANGE_ME@localhost:5433/learning_app?schema=public"

# Keycloak Public Key
PUBLICKEY=

# Outbound email over SMTP with an app password.
# EMAIL_USER is the mailbox everything is sent as (e.g. noreply@yourdomain.com);
# EMAIL_APP_PASSWORD is a Gmail/Workspace app password for that account.
# Leave both blank to log emails locally instead of sending them.
EMAIL_USER=
EMAIL_APP_PASSWORD=
