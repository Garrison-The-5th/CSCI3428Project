{
  "name": "swe-project",
  "version": "0.1.0",
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^9.2.1",
    "cypress": "^15.7.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "setup": "npm run setup-prisma -w api",
    "dev": "concurrently \"npm run dev -w front-end\" \"npm run dev -w api\"",
    "format": "prettier --write ./packages/**/*.{js,jsx,ts,tsx,json,css,md}",
    "typecheck": "tsc -b --noEmit packages/*",
    "build": "npm run build -w front-end",
    "start": "npm run build && npm run start -w api",
    "test": "cypress open"
  },
  "workspaces": [
    "packages/*"
  ]
}
