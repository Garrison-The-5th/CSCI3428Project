{
  "name": "ttg_boilerplate",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run start-front\" \"npm run start-back\"",
    "start-front": "cd frontend && npm run dev",
    "start-back": "cd backend && npm run dev",
    "setup": "docker compose up -d postgres && wait-on tcp:${DB_PORT:-5433} && npm run db:setup --prefix backend",
    "test": "npm run test --prefix backend && npm run test --prefix frontend",
    "test:unit": "npm run test:unit --prefix backend && npm run test --prefix frontend",
    "test:integration": "npm run test:integration --prefix backend",
    "test:e2e": "npm run test:e2e --prefix frontend",
    "test:coverage": "npm run test:coverage --prefix backend && npm run test:coverage --prefix frontend",
    "typecheck": "npm run typecheck --prefix backend && npm run typecheck --prefix frontend",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "lint": "eslint . --max-warnings=0",
    "fix": "eslint . --fix",
    "format": "prettier --write \"**/*.+(js|ts|tsx|json)\"",
    "format:check": "prettier --check \"**/*.+(js|ts|tsx|json)\"",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "db:setup": "npm run db:setup --prefix backend",
    "db:seed": "npm run db:seed --prefix backend",
    "db:migrate": "npm run db:migrate --prefix backend",
    "db:studio": "npm run db:studio --prefix backend"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.7.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "prettier-plugin-classnames": "^0.10.1",
    "wait-on": "^9.0.5"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "keycloak-js": "^26.2.4"
  }
}
