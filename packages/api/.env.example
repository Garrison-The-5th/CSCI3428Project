# Copy this file to `.env` (in packages/api) before running the API.

# SQLite database file (relative paths are resolved from the `prisma/` folder)
DATABASE_URL="file:./dev.db"

# Secret used to sign login tokens. Must be at least 10 characters; use a long random string.
JWT_SECRET="change-me-to-a-long-random-string"

# Port the API (and the built front-end) listens on. Defaults to 5050.
PORT=5050

# Optional: only needed if the front-end is served from a different origin than the API.
# ORIGIN="http://localhost:5173"
